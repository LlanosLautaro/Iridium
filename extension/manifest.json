{
  "manifest_version": 3,
  "name": "Iridium · Revisión de la app",
  "description": "Señalá una parte de tu app en desarrollo y comentala: el comentario llega a su proyecto en Iridium.",
  "version": "0.2.0",
  "key": "",
  "icons": { "128": "icono.png" },
  "action": {
    "default_title": "Revisión de Iridium: comentar esta app (F8)",
    "default_icon": { "128": "icono.png" }
  },
  "background": { "service_worker": "js/sw.js" },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "http://[::1]/*", "file:///*"],
      "js": ["js/pagina.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "http://[::1]/*", "file:///*"],
      "js": ["js/selector.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fuentes/*.woff2"],
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "http://[::1]/*", "file:///*"]
    }
  ]
}
