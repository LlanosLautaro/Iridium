{
  "name": "iridium",
  "version": "1.3.0",
  "private": true,
  "description": "Iridium: plataforma de desarrollo personal donde el usuario dirige con sus ideas y la IA desarrolla.",
  "main": "out/main/index.js",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "set ELECTRON_RUN_AS_NODE=&& electron-vite dev",
    "build": "electron-vite build && node extension/armar.mjs && node tools/armar-plugins.mjs",
    "start": "set ELECTRON_RUN_AS_NODE=&& electron-vite preview",
    "dist": "electron-vite build && node extension/armar.mjs && node tools/armar-plugins.mjs && electron-builder --win --config electron-builder.yml",
    "actualizar": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/actualizar.ps1",
    "publicar": "node --experimental-strip-types tools/publicar.ts",
    "volver": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/volver.ps1",
    "extension": "node extension/armar.mjs && node --experimental-strip-types tools/instalar-extension.ts",
    "claude": "node --experimental-strip-types tools/claude.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "cobertura": "vitest run --coverage",
    "e2e": "electron-vite build && node extension/armar.mjs && node tools/armar-plugins.mjs && playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.extension.json",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.332",
    "@jridgewell/trace-mapping": "0.3.31",
    "electron-updater": "6.8.12",
    "markdown-it": "15.0.3",
    "node-pty": "1.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@electron/asar": "3.4.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.11.6",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "7.3.8",
    "vitest": "5.1.2",
    "zustand": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ]
  }
}
